# Copy to the protected VPS secret location; do not commit the populated file.
# Suggested permissions: root:root 0600, or root:docker 0640 only when the
# container runtime must read it directly.

# Required runtime values
DATABASE_URL=postgresql://cemerlang_app:REDACTED@postgres:5432/cemerlang
AUTH_SECRET=replace-with-random-32-byte-secret
AUTH_URL=https://cemerlangtoys.21kent.com
AUTH_TRUST_HOST=true
SITE_URL=https://cemerlangtoys.21kent.com
AUTH_GOOGLE_ID=replace-with-owner-provided-google-client-id
AUTH_GOOGLE_SECRET=replace-with-owner-provided-google-client-secret
ADMIN_EMAILS=owner@example.invalid

# Optional: the protected admin AI suggestion endpoint returns an error when
# this is absent; it does not block public catalog operation.
OPENAI_API_KEY=replace-if-ai-suggest-remains-enabled
OPENAI_MODEL=gpt-4o-mini

# Not used by the current upload implementation. Uploads use the fixed,
# bind-mounted path documented in deploy/README.md.
# BLOB_READ_WRITE_TOKEN=legacy-not-used-by-current-upload-code
