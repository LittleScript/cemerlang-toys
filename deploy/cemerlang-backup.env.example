# Install outside the repository as /opt/cemerlang-secrets/backup.env.
# The destination must be an off-host/NAS-mounted path, not application storage.
CEMERLANG_BACKUP_DIR=/mnt/nas/backups/cemerlang-toys
CEMERLANG_AGE_RECIPIENT=age1replace-with-owner-recipient
CEMERLANG_UPLOAD_DIR=/opt/cemerlang-toys/uploads
CEMERLANG_RETENTION_DAYS=90
