# Required at runtime in production
DATABASE_URL=postgresql://user:password@host:5432/cemerlang_toys
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=https://cemerlangtoys.example.com
SITE_URL=https://cemerlangtoys.example.com
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

# Required for admin approval controls
ADMIN_EMAILS=admin@example.com

# Optional: only needed when the admin AI suggestion endpoint is enabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional legacy/provider-specific values; not required by the canonical VPS upload path
BLOB_READ_WRITE_TOKEN=
