# Public site origin; keep this environment-specific and domain-portable.
SITE_URL=http://localhost:3000

# PostgreSQL connection string. Never commit a real credential.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Auth.js / Google OAuth runtime configuration.
AUTH_SECRET=replace-with-a-random-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=false
GOOGLE_CLIENT_ID=replace-with-client-id
GOOGLE_CLIENT_SECRET=replace-with-client-secret

# Optional AI-assisted admin content generation.
OPENAI_API_KEY=replace-with-api-key

# Legacy/optional storage variable; current upload code writes to local storage.
BLOB_READ_WRITE_TOKEN=replace-if-storage-is-explicitly-enabled
